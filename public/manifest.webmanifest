{
  "name": "LS Invoice",
  "short_name": "LS Invoice",
  "description": "Invoices, client items and payments in Naira.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#FDF7E6",

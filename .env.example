# Firebase config for LS Invoice. Copy this file to `.env` and fill in the values
# from Firebase console → Project settings → Your apps → Web app → SDK setup.
# `.env` is never committed; these are public web values, safe in the built site,
# and what actually protects the data is `firestore.rules`.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The Drive key keeper: a Cloudflare Worker that holds Google's long-term key (the client secret
# and the refresh token) and hands the app a short-lived Drive access token (scope drive.file).
# The app never sees the secret or the refresh token, and no Google window opens by itself.
# Paste the Worker's own address here, e.g. https://ls-invoice-drive.<your-subdomain>.workers.dev
# (Cloudflare dashboard → Workers & Pages → the Worker → its https://…workers.dev address).
# The SAME address with /callback on the end goes into that OAuth client's "Authorised redirect
# URIs": https://ls-invoice-drive.<your-subdomain>.workers.dev/callback
# Public web value, but no secret and no token is ever put in this file, in the code or in Firestore.
VITE_DRIVE_WORKER_URL=

# The client lookup webhook: an n8n workflow (Webhook node → Google Sheets) that reads the
# business's own Google Sheet and answers with the rows that match. Paste the Webhook node's
# Production URL here (n8n → open the workflow → the Webhook node → "Production URL"), e.g.
# https://your-n8n.example.com/webhook/clients-lookup
# The app asks it with ?q=<what was typed>, and expects back a JSON array of rows, e.g.
#   [ { "name": "Ada", "phone": "+234…", "email": "…", "address": "…" }, … ]
# Read-only: nothing is ever written back to the sheet. Leave empty to hide the sheet lookup.
VITE_CLIENTS_WEBHOOK_URL=
